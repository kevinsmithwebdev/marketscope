{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "paths": {
      "@marketscope/ui": ["../../packages/ui/src/index.ts"],
      "@marketscope/types": ["../../packages/types/src/index.ts"]
    }
  },
  "include": ["src"]
}
